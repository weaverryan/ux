{% extends 'liveDemoBase.html.twig' %}

{% block code_block_full %}
<div class="row" style="margin-top: 60px;">
    <div class="terminal-code">
        <ul class="nav nav-tabs">
            {# set this in the child template #}
            {% for navItem in navItems %}
                <li class="nav-item" role="presentation">
                  <button class="nav-link {{ loop.first ? 'active' }}" data-bs-toggle="tab" data-bs-target="#{{ navItem.id }}" type="button" role="tab" aria-controls="{{ navItem.id }}" aria-selected="{{ loop.first ? 'true' : 'false' }}">{{ navItem.label }}</button>
                </li>
            {% endfor %}
        </ul>
        <div class="tab-content" id="code-tabs">
            {% block demo_code_tabs %}{% endblock %}
        </div>
    </div>
</div>
{% endblock %}
